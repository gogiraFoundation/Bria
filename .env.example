# Copy to .env at the repo root and fill in secrets.
# Loaded by backend/core/config.py (Path relative to backend/core → ../../.env).

# Application
APP_NAME=Bria Forecasting Platform
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Database (use Timescale/PostGIS-capable image in Docker; see docker-compose.yml)
DATABASE_URL=postgresql://bria_admin:bria_secure_password@localhost:5432/bria
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_PASSWORD=bria_secure_password

# Redis
REDIS_URL=redis://:bria_redis_password@localhost:6379/0
REDIS_PASSWORD=bria_redis_password

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Auth
ALLOW_PUBLIC_REGISTRATION=false

# Ingestion (required for HTTP/WS ingest; missing → 503)
INGESTION_API_KEY=change_me_ingestion_key

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Kafka / MQTT (optional local defaults)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Weather failover / OpenWeather-backed paths
OPENWEATHER_API_KEY=
OPENWEATHER_API_URL=https://api.openweathermap.org/data/2.5/forecast
OPENWEATHER_CURRENT_URL=https://api.openweathermap.org/data/2.5/weather

# Solar forecast model (true = nameplate-v1; false = legacy physics-pvlib with module efficiency)
SOLAR_NAMEPLATE_YIELD=true

# Maps
MAPS_PROVIDER=leaflet
GOOGLE_MAPS_API_KEY=

# Monitoring
PROMETHEUS_ENABLED=true
METRICS_PORT=9091

# Frontend (also set in frontend/dashboard/.env if preferred)
# REACT_APP_API_URL=http://localhost:8000/api
# REACT_APP_WS_URL=ws://localhost:8000/api/v1/ws/forecast
# REACT_APP_ALLOW_REGISTRATION=false
